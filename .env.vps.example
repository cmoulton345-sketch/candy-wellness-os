# Radical Simplicity AI OS — VPS Instance Configuration
# This is for your remote Linux VPS server
# Copy this to .env (on VPS only) and fill in real values

# === DEPLOYMENT MODE ===
MODE=VPS
ENVIRONMENT=production
VOICE_ENABLED=false
HEADLESS=true

# === VPS PATHS (Linux) ===
OS_ROOT=/root/radical_simplicity_ai_os_vps
MEMORY_PATH=$OS_ROOT/memory
AGENT_PATH=$OS_ROOT/.agent
WORKFLOW_PATH=$OS_ROOT/n8n_workflows

# === VPS SERVICE PORTS ===
N8N_PORT=5678
OPEN_WEBUI_PORT=3000
WEBHOOK_PORT=8080

# === VOICE CONFIGURATION (Disabled on VPS) ===
VOICE_ENABLED=false

# === VPS CRYPTO TRADING ===
CRYPTO_MODE=VPS
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=your_vps_crypto_api_key
CRYPTO_SECRET_KEY=your_vps_crypto_secret_key
CRYPTO_PAPER_TRADE=false
CRYPTO_LOG_PATH=$OS_ROOT/crypto/logs

# === BACKGROUND PROCESSES ===
PM2_ENABLED=true
N8N_DAEMON=true
WEBHOOK_LISTENER=true
CRON_JOBS_ENABLED=true

# === TELEGRAM BOT (VPS-only) ===
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === EXTERNAL CREDENTIALS (shared across both instances) ===
# These should be the SAME on Local and VPS
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# === VPS SECURITY ===
REQUIRE_SUDO=true
SSH_KEY_PATH=/root/.ssh/id_rsa

# === GIT SYNC ===
GIT_AUTO_SYNC=true
GIT_SYNC_INTERVAL=600
GIT_REPO=https://github.com/joemoulton2022-create/My-personal-AI-OS-backup.git
GIT_BRANCH=main
