# Radical Simplicity AI OS — LOCAL Instance Configuration
# This is for your Windows desktop/laptop
# Copy this to .env (on Local only) and fill in real values

# === DEPLOYMENT MODE ===
MODE=LOCAL
ENVIRONMENT=development
VOICE_ENABLED=true
HEADLESS=false

# === LOCAL PATHS (Windows) ===
OS_ROOT=c:\Users\Joe\radical_simplicity_ai_os_local
MEMORY_PATH=%OS_ROOT%\memory
AGENT_PATH=%OS_ROOT%\.agent
WORKFLOW_PATH=%OS_ROOT%\n8n_workflows

# === LOCAL SERVICE PORTS ===
N8N_PORT=5678
OPEN_WEBUI_PORT=3000
LISTEN_PORT=8888

# === VOICE CONFIGURATION (SAPI) ===
VOICE_WAKE_WORD=Hey Ax
VOICE_ENABLED=true
SAPI_VOICE_NAME=Microsoft Zira Desktop
SAPI_VOICE_RATE=0
SAPI_VOICE_VOLUME=100

# === LOCAL CRYPTO TRADING ===
CRYPTO_MODE=LOCAL
CRYPTO_EXCHANGE=binance
CRYPTO_PAPER_TRADE=true
CRYPTO_LOG_PATH=%OS_ROOT%\crypto\logs

# === EXTERNAL CREDENTIALS (shared across both instances) ===
# These should be the SAME on Local and VPS
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
TELEGRAM_BOT_ENABLED=false

# === GIT SYNC ===
GIT_AUTO_SYNC=true
GIT_SYNC_INTERVAL=300
GIT_REPO=https://github.com/joemoulton2022-create/My-personal-AI-OS-backup.git
GIT_BRANCH=main
