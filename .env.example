# Radical Simplicity AI OS — Environment Variables
# Copy this file to .env and fill in real values.
# This file is safe to commit. The real .env is gitignored.

# Cloudflare API Token — Agent Full Access
# Permissions: Zaraz Admin, Zone Settings Edit, DNS Edit, Pages, Workers, R2, D1, Access
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_API_TOKEN_READ_ALL=your_read_only_fallback_token_here
CLOUDFLARE_ZONE_ID_DICA=your_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook / Meta
FB_PIXEL_ID=your_pixel_id_here
FB_CAPI_ACCESS_TOKEN=your_capi_token_here
FB_ADS_READ_TOKEN=your_ads_read_token_here
# System User — should be permanent, never expires
FB_AD_ACCOUNT_ID=act_your_ad_account_id_here
